              "    const getCartReq = {\r",
              "        url: pm.environment.get(\"base_url\") + '/api/cart',\r",
              "        method: 'GET',\r",
              "        header: {\r",
              "            'Authorization': 'Bearer ' + pm.environment.get(\"auth_token\"),\r",
              "            'Content-Type': 'application/json',\r",
              "            'X-Student-Id': '23127052'\r",
              "        }\r",
              "    };\r",
              "    pm.sendRequest(getCartReq, function (err, res) {\r",
              "        if (!err && res.code === 200) {\r",
              "            const cart = res.json();\r",
              "            pm.test(\"[Chained] Xác minh Security: Giá sản phẩm không bị lưu 1đ vào database\", function () {\r",
              "                const hackedItem = cart.find(i => i.id === 1 && i.price === 1);\r",
