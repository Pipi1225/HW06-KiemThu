    {
      "name": "FR07 - Thêm sản phẩm hợp lệ (Mới)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseSchema = {\r",
              "    \"type\": \"object\",\r",
              "    \"properties\": {\r",
              "        \"message\": { \"type\": \"string\" }\r",
              "    },\r",
              "    \"required\": [\"message\"]\r",
              "};\r",
              "\r",
              "pm.test(\"1. [Schema] Response khớp 100% với Schema định nghĩa (khi request hợp lệ)\", function () {\r",
              "    if (pm.response.code === 200 || pm.response.code === 201) {\r",
              "        pm.response.to.have.jsonSchema(responseSchema);\r",
              "        pm.expect(pm.response.json().message).to.eql(\"Added to cart\");\r",
              "    }\r",
              "});\r",
              "\r",
              "pm.test(\"2. [Domain-Valid] Status code là 200/201 khi truyền body hợp lệ\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"11. [Domain-Name] name hợp lệ (có dấu Tiếng Việt) -> Thành công\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"16. [Domain-Price] price hợp lệ (số nguyên dương) -> Thành công\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"22. [Domain-Quantity] quantity hợp lệ (>=1) -> Thành công\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "pm.test(\"28. [State] Thêm sản phẩm CHƯA CÓ trong giỏ -> Phản hồi thông báo thành công\", function () {\r",
              "    pm.expect(pm.response.json().message).to.eql('Added to cart');\r",
              "});\r",
              "\r",
              "pm.test(\"30. [State] Sau khi thêm, kiểm tra cấu trúc phản hồi thành công\", function () {\r",
              "    pm.expect(pm.response.text()).to.include('Added to cart');\r",
              "});\r",
              "\r",
              "// API Chaining GET /api/cart\r",
              "if (pm.response.code === 200 || pm.response.code === 201) {\r",
              "    const getCartReq = {\r",
              "        url: pm.environment.get(\"base_url\") + '/api/cart',\r",
              "        method: 'GET',\r",
              "        header: {\r",
              "            'Authorization': 'Bearer ' + pm.environment.get(\"auth_token\"),\r",
              "            'Content-Type': 'application/json',\r",
              "            'X-Student-Id': '23127052'\r",
              "        }\r",
              "    };\r",
              "    pm.sendRequest(getCartReq, function (err, res) {\r",
              "        if (!err && res.code === 200) {\r",
              "            const cart = res.json();\r",
              "            \r",
              "            pm.test(\"[Chained] Xác minh State: Sản phẩm xuất hiện trong Giỏ hàng qua GET /api/cart\", function () {\r",
              "                pm.expect(cart).to.be.an('array');\r",
              "                const item = cart.find(i => i.id === 1);\r",
              "                pm.expect(item).to.not.be.undefined;\r",
              "            });\r",
              "\r",
              "            pm.test(\"[Chained] Xác minh State: Tổng tiền giỏ hàng được tính toán lại (> 0)\", function () {\r",
              "                pm.expect(cart).to.be.an('array');\r",
              "                const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);\r",
              "                pm.expect(total).to.be.above(0);\r",
              "            });\r",
              "        }\r",
              "    });\r",
              "}\r"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"id\": 1,\n    \"name\": \"Sản phẩm A\",\n    \"price\": 100000,\n    \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cart",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      },
      "response": []
